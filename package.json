{
  "name": "gitsense",
  "displayName": "GitSense",
  "description": "Makes sense of your repo. Free, local-first git blame, history, and insight \u2014 directly in the editor.",
  "version": "0.1.0",
  "publisher": "gitsense-dev",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gitsense.toggleBlame",
        "title": "GitSense: Toggle Inline Blame",
        "icon": "$(eye)"
      },
      {
        "command": "gitsense.showFileHistory",
        "title": "GitSense: Show File History",
        "icon": "$(history)"
      },
      {
        "command": "gitsense.copySha",
        "title": "GitSense: Copy Commit SHA",
        "icon": "$(copy)"
      },
      {
        "command": "gitsense.showCommit",
        "title": "GitSense: Show Commit Details",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitsense.openGraph",
        "title": "GitSense: Open Commit Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "gitsense.compareBranches",
        "title": "GitSense: Compare Branches",
        "icon": "$(git-compare)"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "gitsense",
          "title": "GitSense",
          "icon": "media/panel-icon.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "gitsense.fileHistory",
          "name": "File History",
          "when": "gitsense.fileHistory.hasContent"
        }
      ],
      "gitsense": [
        {
          "type": "webview",
          "id": "gitsense.commitGraph",
          "name": "Commit Graph"
        },
        {
          "type": "webview",
          "id": "gitsense.commitDetails",
          "name": "Commit Details"
        },
        {
          "type": "webview",
          "id": "gitsense.branchComparison",
          "name": "Branch Comparison"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "gitsense.copySha",
          "when": "view == gitsense.fileHistory && viewItem == gitsense.commit"
        }
      ],
      "view/title": [
        {
          "command": "gitsense.compareBranches",
          "when": "view == gitsense.commitGraph",
          "group": "navigation@1"
        },
        {
          "command": "gitsense.showFileHistory",
          "when": "view == gitsense.commitGraph",
          "group": "navigation@2"
        },
        {
          "command": "gitsense.toggleBlame",
          "when": "view == gitsense.commitGraph",
          "group": "navigation@3"
        },
        {
          "command": "gitsense.openGraph",
          "when": "view == gitsense.commitGraph",
          "group": "navigation@4"
        },
        {
          "command": "gitsense.compareBranches",
          "when": "view == gitsense.branchComparison",
          "group": "navigation@1"
        },
        {
          "command": "gitsense.toggleBlame",
          "when": "view == gitsense.branchComparison",
          "group": "navigation@2"
        },
        {
          "command": "gitsense.showFileHistory",
          "when": "view == gitsense.commitDetails",
          "group": "navigation@1"
        },
        {
          "command": "gitsense.toggleBlame",
          "when": "view == gitsense.commitDetails",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "gitsense.copySha",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "GitSense",
      "properties": {
        "gitsense.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inline blame decorations, hover cards, and the status bar item."
        },
        "gitsense.blame.format": {
          "type": "string",
          "default": "{author}, {age}",
          "description": "Template for the inline blame text. Tokens: {author} {age} {date} {message} {sha}"
        },
        "gitsense.blame.highlightCurrentLine": {
          "type": "boolean",
          "default": true,
          "description": "Highlight the current line's blame decoration."
        },
        "gitsense.blame.ignoreWhitespace": {
          "type": "boolean",
          "default": true,
          "description": "Pass -w to git blame to ignore whitespace-only changes."
        },
        "gitsense.maxBlameFileSize": {
          "type": "number",
          "default": 1048576,
          "description": "Skip blame for files larger than this size, in bytes."
        },
        "gitsense.maxHistoryItems": {
          "type": "number",
          "default": 200,
          "description": "Max commits loaded per file history."
        },
        "gitsense.maxGraphItems": {
          "type": "number",
          "default": 200,
          "description": "Max commits loaded in the commit graph."
        },
        "gitsense.issueLinking.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Auto-link issue/PR references in commit messages (e.g. #123) in the blame hover and commit details."
        },
        "gitsense.issueLinking.pattern": {
          "type": "string",
          "default": "#(\\d+)",
          "description": "Regex matching issue/PR references in commit messages. The first capture group (or the whole match, if none) fills {issue} in the URL template."
        },
        "gitsense.issueLinking.urlTemplate": {
          "type": "string",
          "default": "",
          "description": "'{issue}'-templated URL for issue links, e.g. https://github.com/owner/repo/issues/{issue}. Leave empty to auto-detect from the repo's git remote (GitHub or GitLab)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc --noEmit -p . && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:integration": "npm run compile && tsc -p . --outDir out-test && node out-test/test/integration/runTests.js",
    "lint": "eslint --no-error-on-unmatched-pattern src test && tsc --noEmit -p .",
    "package": "vsce package"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "mocha": "^10.7.3",
    "@types/mocha": "^10.0.9",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
