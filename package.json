{
  "name": "gitlore",
  "displayName": "GitLore — git blame, history & commit graph",
  "description": "The story behind every line. Free, local-first git blame, history, commit graph and branch comparison — no account, no telemetry.",
  "version": "0.1.0",
  "publisher": "RajpratapsinghJadon",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gitLore.toggleBlame",
        "title": "GitLore: Toggle Inline Blame",
        "icon": "$(eye)"
      },
      {
        "command": "gitLore.showFileHistory",
        "title": "GitLore: Show File History",
        "icon": "$(history)"
      },
      {
        "command": "gitLore.copySha",
        "title": "GitLore: Copy Commit SHA",
        "icon": "$(copy)"
      },
      {
        "command": "gitLore.showCommit",
        "title": "GitLore: Show Commit Details",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitLore.openGraph",
        "title": "GitLore: Open Commit Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "gitLore.compareBranches",
        "title": "GitLore: Compare Branches",
        "icon": "$(git-compare)"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "gitLore",
          "title": "GitLore",
          "icon": "media/panel-icon.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "gitLore.fileHistory",
          "name": "File History",
          "when": "gitLore.fileHistory.hasContent"
        }
      ],
      "gitLore": [
        {
          "type": "webview",
          "id": "gitLore.commitGraph",
          "name": "Commit Graph"
        },
        {
          "type": "webview",
          "id": "gitLore.commitDetails",
          "name": "Commit Details"
        },
        {
          "type": "webview",
          "id": "gitLore.branchComparison",
          "name": "Branch Comparison"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "gitLore.copySha",
          "when": "view == gitLore.fileHistory && viewItem == gitLore.commit"
        }
      ],
      "view/title": [
        {
          "command": "gitLore.compareBranches",
          "when": "view == gitLore.commitGraph",
          "group": "navigation@1"
        },
        {
          "command": "gitLore.showFileHistory",
          "when": "view == gitLore.commitGraph",
          "group": "navigation@2"
        },
        {
          "command": "gitLore.toggleBlame",
          "when": "view == gitLore.commitGraph",
          "group": "navigation@3"
        },
        {
          "command": "gitLore.openGraph",
          "when": "view == gitLore.commitGraph",
          "group": "navigation@4"
        },
        {
          "command": "gitLore.compareBranches",
          "when": "view == gitLore.branchComparison",
          "group": "navigation@1"
        },
        {
          "command": "gitLore.toggleBlame",
          "when": "view == gitLore.branchComparison",
          "group": "navigation@2"
        },
        {
          "command": "gitLore.showFileHistory",
          "when": "view == gitLore.commitDetails",
          "group": "navigation@1"
        },
        {
          "command": "gitLore.toggleBlame",
          "when": "view == gitLore.commitDetails",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "gitLore.copySha",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "GitLore",
      "properties": {
        "gitLore.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inline blame decorations, hover cards, and the status bar item."
        },
        "gitLore.blame.format": {
          "type": "string",
          "default": "{author}, {age}",
          "description": "Template for the inline blame text. Tokens: {author} {age} {date} {message} {sha}"
        },
        "gitLore.blame.highlightCurrentLine": {
          "type": "boolean",
          "default": true,
          "description": "Highlight the current line's blame decoration."
        },
        "gitLore.blame.ignoreWhitespace": {
          "type": "boolean",
          "default": true,
          "description": "Pass -w to git blame to ignore whitespace-only changes."
        },
        "gitLore.maxBlameFileSize": {
          "type": "number",
          "default": 1048576,
          "description": "Skip blame for files larger than this size, in bytes."
        },
        "gitLore.maxHistoryItems": {
          "type": "number",
          "default": 200,
          "description": "Max commits loaded per file history."
        },
        "gitLore.maxGraphItems": {
          "type": "number",
          "default": 200,
          "description": "Max commits loaded in the commit graph."
        },
        "gitLore.issueLinking.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Auto-link issue/PR references in commit messages (e.g. #123) in the blame hover and commit details."
        },
        "gitLore.issueLinking.pattern": {
          "type": "string",
          "default": "#(\\d+)",
          "description": "Regex matching issue/PR references in commit messages. The first capture group (or the whole match, if none) fills {issue} in the URL template."
        },
        "gitLore.issueLinking.urlTemplate": {
          "type": "string",
          "default": "",
          "description": "'{issue}'-templated URL for issue links, e.g. https://github.com/owner/repo/issues/{issue}. Leave empty to auto-detect from the repo's git remote (GitHub or GitLab)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run lint && node esbuild.js --production",
    "compile": "tsc --noEmit -p . && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:integration": "npm run compile && tsc -p . --outDir out-test && node out-test/test/integration/runTests.js",
    "lint": "eslint --no-error-on-unmatched-pattern src test && tsc --noEmit -p .",
    "icon": "rsvg-convert -w 256 -h 256 media/icon.svg -o media/icon.png",
    "package": "vsce package",
    "package:pre": "vsce package --pre-release",
    "publish:pre": "vsce publish --pre-release",
    "shots": "tsx scripts/shoot-screenshots.ts"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "mocha": "^10.7.3",
    "@types/mocha": "^10.0.9",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#171B26",
    "theme": "dark"
  },
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/rajjadon/git-retrace.git"
  },
  "bugs": {
    "url": "https://github.com/rajjadon/git-retrace/issues"
  },
  "homepage": "https://github.com/rajjadon/git-retrace#readme",
  "keywords": [
    "git",
    "blame",
    "git history",
    "commit graph",
    "gitlens alternative"
  ]
}
